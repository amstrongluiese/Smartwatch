# ==========================================
# Xiaomi HealthKit Web Application Prototype
# Environment Configuration Template
# ==========================================

# Server Port and Host
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# Xiaomi Developer Platform Configuration
# Register at: https://global.developer.mi.com/ or https://open.xiaomi.com/
# NEVER commit the real .env file with production secrets!
# ==========================================
XIAOMI_CLIENT_ID=your_xiaomi_client_id_here
XIAOMI_CLIENT_SECRET=your_xiaomi_client_secret_here

# Must match the exact redirect URL registered in the Xiaomi Developer Console
XIAOMI_REDIRECT_URI=http://localhost:5000/api/xiaomi/callback

# Official Xiaomi Cloud / HealthKit Endpoints
XIAOMI_API_BASE_URL=https://open-api.aiot.xiaomi.com
XIAOMI_OAUTH_AUTH_URL=https://account.xiaomi.com/oauth2/authorize
XIAOMI_OAUTH_TOKEN_URL=https://account.xiaomi.com/oauth2/token

# Target Wearable Device
TARGET_DEVICE_NAME=Xiaomi Smart Band 9 Active

# Requested HealthKit Authorization Scopes
# Note: com.xiaomi.heart_rate.delta and com.xiaomi.spo2.instantaneous
XIAOMI_HEALTH_SCOPES=com.xiaomi.heart_rate.delta.read com.xiaomi.spo2.instantaneous.read

# ==========================================
# Security & Token Encryption (AES-256-GCM)
# 32-byte hex string (64 characters)
# ==========================================
ENCRYPTION_KEY=c3694f4a3e75e9b814a0f4886612d33451b689bc6a917a26f633e08c87ab42f1

# ==========================================
# Database Configuration
# Supported types: 'sqlite', 'postgres', 'mysql'
# Default is 'sqlite' for instant zero-configuration local development.
# ==========================================
DB_TYPE=sqlite
DB_FILE=./data/healthkit.sqlite

# PostgreSQL Configuration (Uncomment and configure if using PostgreSQL)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_NAME=xiaomi_healthkit

# MySQL Configuration (Uncomment and configure if using MySQL)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=xiaomi_healthkit

# ==========================================
# Capstone Demonstration Mode
# When true, if official Xiaomi credentials are not yet configured or pending developer approval,
# the backend gracefully provides standard-compliant simulated Xiaomi HealthKit data packets
# for Xiaomi Smart Band 9 Active to ensure continuous prototype presentation capability.
# ==========================================
ENABLE_SIMULATION_FALLBACK=true
